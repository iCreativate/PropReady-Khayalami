{
    "name": "propready-ikhayalami",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "dev:local": "NEXT_PUBLIC_APP_URL=http://localhost:3000 next dev --turbopack",
        "dev:clean": "rm -rf .next && next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
        "seed:demo-agent": "curl -s -X POST http://localhost:3000/api/dev/seed-demo-agent | node -e \"let s='';process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>{try{console.log(JSON.stringify(JSON.parse(s),null,2))}catch{console.log(s)}})\"",
        "seed:demo-originator": "curl -s -X POST http://localhost:3000/api/dev/seed-demo-originator | node -e \"let s='';process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>{try{console.log(JSON.stringify(JSON.parse(s),null,2))}catch{console.log(s)}})\"",
        "seed:demo-leads": "curl -s -X POST http://localhost:3000/api/dev/seed-demo-leads | node -e \"let s='';process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>{try{console.log(JSON.stringify(JSON.parse(s),null,2))}catch{console.log(s)}})\"",
        "seed:demo-users": "curl -s -X POST http://localhost:3000/api/dev/seed-demo-users | node -e \"let s='';process.stdin.on('data',d=>s+=d);process.stdin.on('end',()=>{try{console.log(JSON.stringify(JSON.parse(s),null,2))}catch{console.log(s)}})\"",
        "scrape:suburbs": "node scripts/scrape-property24-suburbs.mjs",
        "scrape:suburbs:sample": "node scripts/scrape-property24-suburbs.mjs --limit=500",
        "mobile:sync": "npx cap sync",
        "mobile:android": "npx cap open android",
        "mobile:ios": "npx cap open ios",
        "mobile:add": "npx cap add android && npx cap add ios",
        "mobile:build:android": "npx cap sync && cd android && ./gradlew assembleDebug",
        "mobile:build:android:release": "npx cap sync && cd android && ./gradlew assembleRelease bundleRelease",
        "mobile:build:ios": "npx cap sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build"
    },
    "dependencies": {
        "@auth/supabase-adapter": "^1.7.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/core": "^8.4.2",
        "@capacitor/keyboard": "^8.0.5",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3",
        "@opentelemetry/api": "^1.9.1",
        "@supabase/ssr": "^0.10.3",
        "@supabase/supabase-js": "^2.107.0",
        "argon2": "^0.44.0",
        "browser-image-compression": "^2.0.2",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.0",
        "date-fns": "^3.0.0",
        "jose": "^6.2.3",
        "jspdf": "^4.0.0",
        "lucide-react": "^0.344.0",
        "next": "^15.5.7",
        "next-auth": "^5.0.0-beta.25",
        "qrcode": "^1.5.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "recharts": "^2.15.0",
        "resend": "^3.2.0",
        "tailwind-merge": "^2.2.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@capacitor/android": "^8.4.2",
        "@capacitor/cli": "^8.4.2",
        "@capacitor/ios": "^8.4.2",
        "@netlify/plugin-nextjs": "^5.15.5",
        "@types/node": "^20",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "autoprefixer": "^10.4.22",
        "eslint": "^8",
        "eslint-config-next": "15.5.7",
        "postcss": "^8",
        "tailwindcss": "^3.4.1",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5"
    }
}

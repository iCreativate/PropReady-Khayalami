# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Supabase (Settings → API in dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt_key_here
# REQUIRED on Netlify for register/login/OAuth session creation (service_role secret — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_key_here

# PropReady staff console (comma-separated). Open /admin/login directly — not linked in the public app.
# Also accepts PROPREADY_ADMIN_EMAILS as an alias.
ADMIN_EMAILS=admin@propready.co.za

# NextAuth (legacy — prefer AUTH_JWT_SECRET)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_secret_here
# REQUIRED on Netlify for Google/Apple OAuth + sessions (min 32 characters)
AUTH_JWT_SECRET=generate_a_random_secret_at_least_32_chars

# OAuth providers (configure in provider consoles; redirect URI: /api/auth/oauth/{provider}/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# App URL — MUST be https://propready.live on Netlify (not localhost or OAuth redirects break)
# Locally keep BOTH as http://localhost:3000 or Google returns redirect_uri_mismatch.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXTAUTH_URL should match NEXT_PUBLIC_APP_URL in each environment
# Google Console authorized redirect URIs must include:
#   http://localhost:3000/api/auth/oauth/google/callback
#   https://propready.live/api/auth/oauth/google/callback

# Capacitor native shell (Android/iOS WebView). Defaults to NEXT_PUBLIC_APP_URL, then https://propready.live
# CAPACITOR_SERVER_URL=https://propready.live

# App store listing URLs (footer download badges)
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=za.co.propready.app

# Resend (Email) — domain in RESEND_FROM_EMAIL must be verified in Resend dashboard
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=PropReady <noreply@your-verified-domain.com>
# Optional: allow login OTP without Resend outside development (shows/uses code server-side fallback)
# ALLOW_LOGIN_OTP_DEV_FALLBACK=true

# PayFast (Payment Gateway)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_SANDBOX=true

# Bond Originator APIs (Placeholders for MVP)
BETTERBOND_API_KEY=placeholder
OOBA_API_KEY=placeholder
SA_HOME_LOANS_API_KEY=placeholder

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
# Optional Map ID for Advanced Markers (Google Cloud → Map Management). Falls back to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# WhatsApp Business API
WHATSAPP_API_KEY=placeholder

# Demo agent (development only) — seed with: npm run seed:demo-agent
# Demo buyer & seller — seed with: npm run seed:demo-users
# Demo conveyancer — seed with: npm run seed:demo-conveyancer
# Demo verified leads — seed with: npm run seed:demo-leads (after demo agent login)
# ALLOW_DEMO_SEED=true enables seed API outside NODE_ENV=development
#
# Demo buyer:  lerato.demo@prop-ready.co.za  / Demo@123!  → /login → /dashboard
# Demo seller: john.demo@prop-ready.co.za   / Demo@123!  → /login → /sellers/dashboard
# Demo agent:  demo.agent@prop-ready.co.za   / Demo@123!  → /agents/login
# Demo conveyancer (JHB): demo.conveyancer@prop-ready.co.za     / Demo@123!  → /conveyancers/login
# Demo conveyancer (CPT): demo.conveyancer.cpt@prop-ready.co.za / Demo@123!  → /conveyancers/login
# Optional override: DEMO_CONVEYANCER_PASSWORD=Demo@123!